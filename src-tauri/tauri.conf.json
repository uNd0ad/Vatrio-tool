{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vatrio Tool",
  "version": "0.2.0",
  "identifier": "com.fhholdings.vatriotool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vatrio Tool",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW5pY29ybiBwb3dlciBkdW1teSBrZXkgMTIzNDU2Nzg5MA==",
      "endpoints": []
    },
    "deep-link": {
      "schemes": ["vatrio"]
    }
  }
}
