{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vatrio Tool",
  "version": "0.3.2",
  "identifier": "com.fhholdings.vatriotool",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Vatrio Tool",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQzQ0E3QzgwQTZGQUFCRkYKUldUL3EvcW1nSHpLUSt2M0dOWWJmajhMTU04RXBUdis5aVB5T0ZPK0pWMWVQQjNXU3dvbmVwWFkK",
      "endpoints": ["https://github.com/uNd0ad/Vatrio-tool/releases/latest/download/latest.json"]
    },
    "deep-link": {
      "schemes": ["vatrio"]
    }
  }
}
