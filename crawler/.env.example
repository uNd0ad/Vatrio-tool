SUPABASE_URL=https://wtomsmyfgjcvyaunaiur.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional Slack-compatible incoming webhook for zero-result crawl alerts.
CRAWLER_ALERT_WEBHOOK_URL=

# Set to true to scrape and report without writing to Supabase.
CRAWLER_DRY_RUN=false

# Optional healthchecks.io-compatible URL pinged after each scheduled run.
CRAWLER_HEARTBEAT_URL=

# Optional comma-separated proxy pool; one proxy is selected per crawler run.
PROXIES=

# Consume atomically claimed crawl_jobs instead of the built-in search list.
CRAWLER_QUEUE_ENABLED=false

CRAWLER_CIRCUIT_FAILURES=3
CRAWLER_CIRCUIT_COOLDOWN_MS=900000

# Optional per-site minimum intervals, e.g. olx:60,storia:120
CRAWLER_SITE_INTERVAL_MINUTES=

CRAWLER_STALE_AFTER_DAYS=30

CRAWLER_MAX_PAGES=20

# Optional per-site Playwright timeouts, e.g. olx:20000,storia:30000
CRAWLER_SITE_TIMEOUT_MS=

# Optional comma-separated subset: olx,storia,imobiliare,homezz,publi24
CRAWLER_ENABLED_SITES=

CRAWLER_MEMORY_GROWTH_MB=256

CRAWLER_MAX_RESTARTS=5

# Optional crawl summary email via Resend.
RESEND_API_KEY=
CRAWLER_SUMMARY_EMAIL_TO=
CRAWLER_SUMMARY_EMAIL_FROM=
